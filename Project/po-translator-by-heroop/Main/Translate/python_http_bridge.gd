	var tmp_py := OS.get_user_data_dir().path_join("_po_check.py")
	var f := FileAccess.open(tmp_py, FileAccess.WRITE)
	if f == null:
		return {"available": false, "message": "无法写入脚本"}
	f.store_string(check_script)
	f.close()

	var out: Array = []
