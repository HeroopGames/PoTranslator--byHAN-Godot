# === PoTranslatorByHAN · Python HTTP 桥接 ===
# 提供 WorkerThreadPool 后台线程入口
# Python 脚本内嵌在 EMBEDDED_PY_B64 常量中，导出后无需外部文件
# 注意：翻译 API 支持 Google（非官方，模拟网页翻译）/ 本地部署的 SimplyTranslate、LingvaTranslate（LibreTranslate 已停用保留）
class_name PythonHttpBridge
extends RefCounted

const PY_SCRIPT_PATH = "res://Main/Translate/translate_full.py.txt"

static var _running_pid: int = -1
static var _cancel_flag: bool = false

## 内嵌 Python 脚本（Base64），优先读文件，兜底用此常量
const EMBEDDED_PY_B64 = ""

## 共享结果已废弃：改用调用方传入的 result_holder，
## 避免被放弃的旧检测任务完成后覆盖新检测的结果（张冠李戴竞态）
static var _tmp_counter: int = 0

## 生成唯一临时脚本路径：避免新旧并发任务共用固定文件名，
## 旧任务结束时删除文件导致新任务执行失败
static func _unique_temp_py(prefix: String) -> String:
	return OS.get_user_data_dir().path_join("%s_%d_%d.py" % [prefix, Time.get_ticks_msec(), _next_temp_id()])

static func _next_temp_id() -> int:
	_tmp_counter += 1
	return _tmp_counter

## 将 Python 脚本拷贝到 user:// 临时路径（唯一文件名，避免新旧任务互相删除）
static func copy_script_to_temp(script_name: String = "_po_full_translate.py") -> String:
	var content := _read_py_script()
	if content.is_empty():
		return ""
	var dst_path := OS.get_user_data_dir().path_join(script_name.replace(".py", "_%d_%d.py" % [Time.get_ticks_msec(), _next_temp_id()]))
	var dst := FileAccess.open(dst_path, FileAccess.WRITE)
	if dst == null:
		return ""
	dst.store_string(content)
	dst.close()
	return dst_path

## 读取脚本内容：优先 res:// 文件 → exe 同级 → 内嵌 Base64
static func _read_py_script() -> String:
	# 策略 1：res:// 文件
	var src := FileAccess.open(PY_SCRIPT_PATH, FileAccess.READ)
	if src:
		var c := src.get_as_text(); src.close()
		return c

	# 策略 2：exe 同级目录
	if not OS.has_feature("editor"):
		var exe_dir := OS.get_executable_path().get_base_dir()
		var exe_py := exe_dir.path_join("translate_full.py.txt")
		src = FileAccess.open(exe_py, FileAccess.READ)
		if src:
			var c := src.get_as_text(); src.close()
			return c

	# 策略 3：内嵌 Base64（保证可用）
	if not EMBEDDED_PY_B64.is_empty():
		return Marshalls.base64_to_utf8(EMBEDDED_PY_B64)

	return ""


# ======== API 检测 ========

## 后台线程入口：结果写入调用方传入的 result_holder，
## 避免被放弃的旧检测任务完成后覆盖新检测结果
static func check_api(url: String, api_type: String, result_holder: Dictionary):
	var r := _do_check(url, api_type)
	result_holder["available"] = r.get("available", false)
	result_holder["message"] = r.get("message", "")

## 检测脚本模板：用守护线程 + join 超时做硬性看门狗。
## DNS 解析不受 urllib 的 timeout 约束，网络被劫持或无响应时可能挂起数十秒，
## 导致界面一直停在“检测中”，因此必须在脚本层兜底超时（超时后进程可正常退出）。
const CHECK_TEMPLATE := """
import json, sys, threading, ssl, urllib.request, urllib.parse
url = sys.argv[1] if len(sys.argv) > 1 else ""
_result = {}
def _work():
    try:
%s
    except Exception as e:
        _result.update({"available": False, "message": str(e)})
_thread = threading.Thread(target=_work, daemon=True)
_thread.start()
_thread.join(8)
if _thread.is_alive():
    _result = {"available": False, "message": "检测超时：网络无响应"}
print(json.dumps(_result))
"""

static func _do_check(url: String, api_type: String) -> Dictionary:
	var cmd := _find_python()
	if cmd.is_empty():
		return {"available": false, "message": "Python 不可用"}

	var body := ""
	if api_type == "simplytranslate":
		# SimplyTranslate: GET /api/translate/?engine=google&from=..&to=..&text=..
		# 检测标准：接口可达且返回非空 translated_text（即翻译成功）
		body = """
        base = url.rstrip("/")
        ctx = ssl.create_default_context()
        req = base + "/api/translate/?engine=google&from=en&to=zh-CN&text=test"
        hdr = {"User-Agent": "Mozilla/5.0"}
        r = urllib.request.urlopen(urllib.request.Request(req, headers=hdr), timeout=5, context=ctx)
        data = json.loads(r.read().decode(errors="replace"))
        ok = isinstance(data, dict) and str(data.get("translated_text", "")).strip() != ""
        _result.update({"available": ok, "message": "API OK" if ok else "bad response"})
"""
	elif api_type == "lingva":
		# LingvaTranslate: GET /api/v1/{source}/{target}/{query}
		# 检测标准：接口可达且返回非空 translation（即翻译成功）
		body = """
        base = url.rstrip("/")
        ctx = ssl.create_default_context()
        req = base + "/api/v1/en/zh/test"
        hdr = {"User-Agent": "Mozilla/5.0"}
        r = urllib.request.urlopen(urllib.request.Request(req, headers=hdr), timeout=5, context=ctx)
        data = json.loads(r.read().decode(errors="replace"))
        ok = isinstance(data, dict) and str(data.get("translation", "")).strip() != ""
        _result.update({"available": ok, "message": "API OK" if ok else "bad response"})
"""
	elif api_type == "google":
		# Google 非官方接口（模拟网页翻译）: GET /translate_a/single?client=dict-chrome-ex&dt=t...
		# 检测标准：接口可达且返回非空译文（即翻译成功）
		body = """
        base = url.rstrip("/") if url else "https://clients5.google.com"
        ctx = ssl.create_default_context()
        req = base + "/translate_a/single?client=dict-chrome-ex&dt=t&sl=en&tl=zh-CN&q=test"
        hdr = {"User-Agent": "Mozilla/5.0"}
        r = urllib.request.urlopen(urllib.request.Request(req, headers=hdr), timeout=5, context=ctx)
        data = json.loads(r.read().decode(errors="replace"))
        ok = isinstance(data, list) and len(data) > 0 and isinstance(data[0], list) and len(data[0]) > 0 and str(data[0][0][0]).strip() != ""
        _result.update({"available": ok, "message": "API OK" if ok else "bad response"})
"""
	else:
		# LibreTranslate（已停用，保留兼容）：POST /translate
		body = """
        base = url.rstrip("/")
        ctx = ssl.create_default_context()
        req = base + "/translate"
        hdr = {"User-Agent": "Mozilla/5.0", "Content-Type": "application/json"}
        payload = json.dumps({"q": "test", "source": "en", "target": "zh-Hans", "format": "text"}).encode("utf-8")
        r = urllib.request.urlopen(urllib.request.Request(req, data=payload, headers=hdr, method="POST"), timeout=5, context=ctx)
        data = json.loads(r.read().decode(errors="replace"))
        ok = isinstance(data, dict) and "translatedText" in data
        _result.update({"available": ok, "message": "API OK" if ok else "bad response"})
"""
	var check_script := CHECK_TEMPLATE % body
	var tmp_py := _unique_temp_py("_po_check")
	var f := FileAccess.open(tmp_py, FileAccess.WRITE)
	if f == null:
		return {"available": false, "message": "无法写入脚本"}
	f.store_string(check_script)
	f.close()

	var out: Array = []
	var ec := OS.execute(cmd, [tmp_py, url], out, true)
	DirAccess.remove_absolute(tmp_py)
	if ec != 0 or out.is_empty():
		return {"available": false, "message": "请求失败"}
	var p = JSON.parse_string(out[0])
	if p is Dictionary:
		return {"available": p.get("available", false), "message": str(p.get("message", ""))}
	return {"available": false, "message": "解析失败"}


# ======== 单条翻译 ========

## 后台线程入口：结果写入调用方传入的 result_holder，避免并发任务互相覆盖
static func translate_single(text: String, src_lang: String, target_lang: String, api_type: String, api_url: String, result_holder: Dictionary):
	var r := _do_translate_single(text, src_lang, target_lang, api_type, api_url)
	result_holder["ok"] = r.get("ok", false)
	result_holder["text"] = r.get("text", "")
	result_holder["message"] = r.get("message", "")

static func _do_translate_single(text: String, src_lang: String, target_lang: String, api_type: String, api_url: String) -> Dictionary:
	var cmd := _find_python()
	if cmd.is_empty():
		return {"ok": false, "text": "", "message": "Python 不可用"}

	var script := """
import json, sys, base64, urllib.request, urllib.parse, ssl
text = base64.b64decode(sys.argv[1]).decode("utf-8")
src_lang = sys.argv[2]
target_lang = sys.argv[3]
api_type = sys.argv[4]
api_url = sys.argv[5] if len(sys.argv) > 5 else ""
ctx = ssl.create_default_context()
def conv_lingva(code):
    m = {"zh-CN": "zh", "zh-TW": "zh_HANT", "auto": "auto"}
    return m.get(code, code)
try:
    if api_type == "simplytranslate":
        base = api_url.rstrip("/") if api_url else "http://localhost:5000"
        url = base + "/api/translate/?engine=google&from=%s&to=%s&text=%s" % (
            urllib.parse.quote(src_lang), urllib.parse.quote(target_lang), urllib.parse.quote(text.encode("utf-8"))
        )
        hdr = {"User-Agent": "Mozilla/5.0"}
        r = urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=8, context=ctx)
        data = json.loads(r.read().decode(errors="replace"))
        result = ""
        if isinstance(data, dict):
            result = str(data.get("translated_text", "") or data.get("translated-text", ""))
        if result.strip():
            print(json.dumps({"ok": True, "text": result}))
        else:
            print(json.dumps({"ok": False, "text": "", "message": "bad response"}))
    elif api_type == "lingva":
        base = api_url.rstrip("/") if api_url else "http://localhost:3000"
        url = base + "/api/v1/%s/%s/%s" % (
            urllib.parse.quote(conv_lingva(src_lang)), urllib.parse.quote(conv_lingva(target_lang)),
            urllib.parse.quote(text.encode("utf-8"))
        )
        hdr = {"User-Agent": "Mozilla/5.0"}
        r = urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=8, context=ctx)
        data = json.loads(r.read().decode(errors="replace"))
        result = ""
        if isinstance(data, dict):
            result = str(data.get("translation", ""))
        if result.strip():
            print(json.dumps({"ok": True, "text": result}))
        else:
            print(json.dumps({"ok": False, "text": "", "message": "bad response"}))
    elif api_type == "google":
        # Google 非官方接口（模拟网页翻译）
        base = api_url.rstrip("/") if api_url else "https://clients5.google.com"
        url = base + "/translate_a/single?client=dict-chrome-ex&dt=t&sl=%s&tl=%s&q=%s" % (
            urllib.parse.quote(src_lang), urllib.parse.quote(target_lang),
            urllib.parse.quote(text.encode("utf-8"))
        )
        hdr = {"User-Agent": "Mozilla/5.0"}
        r = urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=8, context=ctx)
        data = json.loads(r.read().decode(errors="replace"))
        parts = []
        if isinstance(data, list) and len(data) > 0 and isinstance(data[0], list):
            for seg in data[0]:
                if isinstance(seg, list) and len(seg) > 0 and seg[0]:
                    parts.append(str(seg[0]))
        result = "".join(parts)
        if result.strip():
            print(json.dumps({"ok": True, "text": result}))
        else:
            print(json.dumps({"ok": False, "text": "", "message": "bad response"}))
    else:
        # LibreTranslate（已停用，保留兼容）
        base = api_url.rstrip("/") if api_url else "http://localhost:5000"
        url = base + "/translate"
        def conv(code):
            m = {"zh-CN": "zh-Hans", "zh-TW": "zh-Hant", "auto": "auto"}
            return m.get(code, code)
        payload = json.dumps({"q": text, "source": conv(src_lang), "target": conv(target_lang), "format": "text"}).encode("utf-8")
        hdr = {"User-Agent": "Mozilla/5.0", "Content-Type": "application/json"}
        req = urllib.request.Request(url, data=payload, headers=hdr, method="POST")
        r = urllib.request.urlopen(req, timeout=8, context=ctx)
        data = json.loads(r.read().decode(errors="replace"))
        if isinstance(data, dict) and "translatedText" in data:
            print(json.dumps({"ok": True, "text": data["translatedText"]}))
        else:
            print(json.dumps({"ok": False, "text": "", "message": "bad response"}))
except Exception as e:
    print(json.dumps({"ok": False, "text": "", "message": str(e)}))
"""

	var tmp_py := _unique_temp_py("_po_translate_single")
	var f := FileAccess.open(tmp_py, FileAccess.WRITE)
	if f == null:
		return {"ok": false, "text": "", "message": "无法写入脚本"}
	f.store_string(script)
	f.close()

	var out: Array = []
	var b64 := Marshalls.utf8_to_base64(text)
	var ec := OS.execute(cmd, [tmp_py, b64, src_lang, target_lang, api_type, api_url], out, true)
	DirAccess.remove_absolute(tmp_py)
	if ec != 0 or out.is_empty():
		return {"ok": false, "text": "", "message": "请求失败"}
	var p = JSON.parse_string(out[0])
	if p is Dictionary:
		return {"ok": bool(p.get("ok", false)), "text": str(p.get("text", "")), "message": str(p.get("message", ""))}
	return {"ok": false, "text": "", "message": "解析失败"}


# ======== 全流程翻译（纯执行器） ========

static func cancel_translate():
	_cancel_flag = true
	if _running_pid > 0:
		if OS.is_process_running(_running_pid):
			OS.kill(_running_pid)
		_running_pid = -1

## 由主线程在 add_task 之前调用，重置取消标志。
## 不在 run_full_translate 内部重置，避免"取消发生在任务启动前被清除"的竞态
static func reset_cancel():
	_cancel_flag = false


static func run_full_translate(po_path: String, src_lang: String, target_lang: String, batch_size: int, progress_path: String, script_temp_path: String, project_path: String = "", api_type: String = "simplytranslate", api_url: String = ""):
	_write_bridge_log(progress_path, "bridge start")
	_write_bridge_log(progress_path, "  po_path=%s" % po_path)
	_write_bridge_log(progress_path, "  progress_path=%s" % progress_path)
	_write_bridge_log(progress_path, "  project_path=%s" % project_path)
	_write_bridge_log(progress_path, "  script_temp=%s" % script_temp_path)
	_write_bridge_log(progress_path, "  src=%s target=%s" % [src_lang, target_lang])
	_write_bridge_log(progress_path, "  api_type=%s api_url=%s" % [api_type, api_url])

	if FileAccess.file_exists(progress_path):
		DirAccess.remove_absolute(progress_path)

	var cmd := _find_python()
	_write_bridge_log(progress_path, "  python=%s" % cmd)

	if cmd.is_empty():
		_write_bridge_log(progress_path, "  ERROR: Python not found")
		return

	if script_temp_path.is_empty():
		_write_bridge_log(progress_path, "  ERROR: script path empty")
		return

	var args := PackedStringArray([script_temp_path, po_path, src_lang, target_lang, str(batch_size), progress_path, project_path, api_type, api_url])
	_write_bridge_log(progress_path, "  executing (create_process)...")

	var pid := OS.create_process(cmd, args, false)
	_running_pid = pid

	if pid == -1:
		_write_bridge_log(progress_path, "  ERROR: Failed to create process")
		_running_pid = -1
		return

	# 取消可能发生在 create_process 之前（_cancel_flag 已置位但当时无 pid 可杀）：
	# 立即补杀，避免 worker 线程与子进程悬挂
	if _cancel_flag:
		if OS.is_process_running(pid):
			OS.kill(pid)
		_running_pid = -1
		DirAccess.remove_absolute(script_temp_path)
		_write_bridge_log(progress_path, "  bridge cancelled before poll")
		return

	# Poll until process completes or cancelled
	while OS.is_process_running(pid):
		if _cancel_flag:
			_write_bridge_log(progress_path, "  CANCELLED, killing PID=%d" % pid)
			OS.kill(pid)
			_running_pid = -1
			DirAccess.remove_absolute(script_temp_path)
			if FileAccess.file_exists(progress_path):
				DirAccess.remove_absolute(progress_path)
			_write_bridge_log(progress_path, "  bridge cancelled")
			return
		OS.delay_msec(200)

	_running_pid = -1
	DirAccess.remove_absolute(script_temp_path)
	_write_bridge_log(progress_path, "  bridge done")

static func _write_bridge_log(progress_path: String, msg: String):
	var log_path := progress_path.replace("_progress.json", "_bridge.log")
	var f := FileAccess.open(log_path, FileAccess.WRITE_READ)
	if f:
		f.seek_end()
		f.store_string(msg + "\n")
		f.close()

static var _python_cmd_cache: String = ""
static var _python_cmd_found: bool = false

static func _find_python() -> String:
	# 缓存结果：避免每次检测/翻译都再 spawn 2~3 个 python 子进程探测
	if _python_cmd_found:
		return _python_cmd_cache
	var o: Array = []
	if OS.execute("python", ["--version"], o, true) == 0:
		_python_cmd_cache = "python"
	elif OS.execute("python3", ["--version"], o, true) == 0:
		_python_cmd_cache = "python3"
	else:
		_python_cmd_cache = ""
	_python_cmd_found = true
	return _python_cmd_cache
